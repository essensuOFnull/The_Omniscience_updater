{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local updater window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-start-install",
    "allow-get-manager-state",
    "allow-get-output-log-path",
    "allow-set-manager-state",
    "allow-list-installed-versions",
    "allow-check-prerequisites",
    "allow-inspect-source",
    "allow-prepare-release",
    "allow-check-latest-release",
    "allow-launch-omniscience",
    "allow-stop-all-omniscience",
    "allow-open-github-browser",
    "allow-navigate-github-browser",
    "allow-open-github-devtools",
    "allow-install-github-artifact"
  ]
}
